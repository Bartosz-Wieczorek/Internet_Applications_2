{% extends 'base.html.twig' %}

{% block title %}Measurement index{% endblock %}

{% block body %}
    <h1>Measurement index</h1>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th class="d-none d-md-table-cell">Id</th>
                <th>Location</th>
                <th>Date</th>
                <th>Celsius</th>
                <th class="d-none d-md-table-cell">Precipitation</th>
                <th class="d-none d-md-table-cell">WindSpeed</th>
                <th class="d-none d-md-table-cell">Pressure</th>
                <th class="d-none d-md-table-cell">Humidity</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for measurement in measurements %}
            <tr>
                <td class="d-none d-md-table-cell">{{ measurement.id }}</td>
                <td>{{ measurement.location.city }}</td>
                <td>{{ measurement.date ? measurement.date|date('Y-m-d') : '' }}</td>
                <td>{{ measurement.celsius }}</td>
                <td class="d-none d-md-table-cell">{{ measurement.precipitation }}</td>
                <td class="d-none d-md-table-cell">{{ measurement.windSpeed }}</td>
                <td class="d-none d-md-table-cell">{{ measurement.pressure }}</td>
                <td class="d-none d-md-table-cell">{{ measurement.humidity }}</td>
                <td>
                    <a href="{{ path('app_measurement_show', {'id': measurement.id}) }}">show</a>
                    <a href="{{ path('app_measurement_edit', {'id': measurement.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

    <a href="{{ path('app_measurement_new') }}">Create new</a>
{% endblock %}
